# Database (Postgres). On Vercel, use Neon pooled + unpooled URLs.
# Local Docker: docker compose up -d
DATABASE_URL="postgresql://axon:axon@localhost:5432/axon?schema=public"
DATABASE_URL_UNPOOLED="postgresql://axon:axon@localhost:5432/axon?schema=public"

# Auth — generate a long random value for production
# openssl rand -base64 32
AUTH_SECRET="change-me"

# Vercel Blob (required on Vercel for product / listing photo uploads)
# Created automatically when you add a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# Email (SMTP) — verification codes + order confirmations
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AXON.MK <noreply@axon.mk>"
# Optional: also receive a copy of every order email (defaults to SMTP_USER)
ORDER_NOTIFY_EMAIL=
